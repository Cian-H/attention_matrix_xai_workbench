# Common Python / Nix project ignores
# Virtual environment
.venv/
# Python cache
__pycache__/
*.py[cod]
*$py.class
# Jupyter / marimo notebooks checkpoints
.ipynb_checkpoints/
__marimo__/
# VS Code / IDE settings
.vscode/
.idea/
# Build artifacts
build/
Dist/
*.egg-info/
# Test caches
.pytest_cache/
.coverage
htmlcov/
# Nix files generated by devenv
.devenv/
# macOS system files
.DS_Store
# Other temporary files
*.log
